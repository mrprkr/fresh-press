{
  "name": "fresh-press",
  "version": "1.0.0",
  "description": "A fresh brew for your fresh machine — TUI to terraform a macOS dev environment",
  "type": "module",
  "bin": {
    "fresh-press": "./bin/restore.js"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "build": "tsc",
    "restore": "tsx src/cli.tsx",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "keywords": [
    "macos",
    "restore",
    "setup",
    "tui"
  ],
  "author": "mrprkr",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.6",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.58.0"
  }
}
